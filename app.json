{
  "expo": {
    "name": "MyTurn",
    "slug": "myturn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "myturn",
    "ios": {
      "buildNumber": "21",
      "supportsTablet": false,
      "bundleIdentifier": "com.emirozdis.myturnapp",
      "associatedDomains": [
        "applinks:myturn.emirozdis.tr"
      ],
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.emirozdis.myturnapp"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "FIREBASE_ANALYTICS_COLLECTION_ENABLED": false,
        "GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS": false,
        "NSCameraUsageDescription": "Uygulamanın günlük vloglarınızı kaydedebilmesi için kamera iznine ihtiyacı vardır.",
        "NSMicrophoneUsageDescription": "Uygulamanın günlük vloglarınızın sesini kaydedebilmesi için mikrofon iznine ihtiyacı vardır.",
        "NSPhotoLibraryUsageDescription": "Uygulamanın fotoğraflarınızı paylaşabilmesi için galeri iznine ihtiyacı vardır."
      },
      "appleTeamId": "M4W24MNU8D"
    },
    "android": {
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.emirozdis.myturn",
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myturn.emirozdis.tr",
              "pathPrefix": "/group/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "dark"
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Uygulamanın günlük vloglarınızı kaydedebilmesi için kamera iznine ihtiyacı vardır.",
          "microphonePermission": "Uygulamanın günlük vloglarınızın sesini kaydedebilmesi için mikrofon iznine ihtiyacı vardır.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Konumunuzu gönderilerinize otomatik olarak eklemek için konum erişimine ihtiyacımız var. Paylaşmadan önce konumu düzenleyebilirsiniz."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProps": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m -XX:+UseG1GC"
            }
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAppCheck",
              "RNFBMessaging",
              "RNFBCrashlytics"
            ]
          }
        }
      ],
      "./plugins/withFirebaseConfigure.js",
      "./plugins/withAndroidJvm17.js",
      "./plugins/withAndroidUploadSigning.js",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.emirozdis.myturnapp.ExpoWidgets",
          "groupIdentifier": "group.com.emirozdis.myturnapp",
          "widgets": [
            {
              "name": "TodayVlogger",
              "displayName": "Today's Vlogger",
              "description": "Who is documenting today.",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall"
              ]
            },
            {
              "name": "YourTurn",
              "displayName": "Your Turn",
              "description": "Encouragement to contribute",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall"
              ]
            },
            {
              "name": "YesterdayRecap",
              "displayName": "Yesterday's Recap",
              "description": "Watch yesterday's story",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemLarge"
              ]
            },
            {
              "name": "LatestClip",
              "displayName": "Latest Published Clip",
              "description": "Most recent uploaded clip",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemLarge"
              ]
            },
            {
              "name": "DailyStoryProgress",
              "displayName": "Daily Story Progress",
              "description": "Live snapshot of today's story",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall"
              ]
            }
          ]
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.emirozdis.myturnapp.ExpoWidgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.emirozdis.myturnapp"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "b9cd2e6f-171e-4172-be67-66518eb94976"
      }
    },
    "owner": "emirozdis"
  }
}
