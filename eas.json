{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "LOAD_LOCAL_ENV": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_BUILD_PROFILE": "preview"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6792202991"
      }
    },
    "android-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "android-beta": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6792202991"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
