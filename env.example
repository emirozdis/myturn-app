# Copy to .env.development and keep it out of Git.
# Environment identity is set by npm scripts; do not add APP_ENV,
# EXPO_PUBLIC_APP_ENV, or LOAD_LOCAL_ENV to this file.
# `localhost` works on iOS and is automatically mapped to the Android
# emulator host alias (10.0.2.2) in development.
EXPO_PUBLIC_API_URL="http://localhost:3000"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY="test_..."
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY="test_..."

# Optional for local simulator/development builds. Register this token in
# Firebase Console > App Check. Never add it to the production EAS environment.
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=""

# React Native Firebase reads these local native files through app.config.js:
# ./GoogleService-Info.plist
# ./google-services.json

# For local production/preview, configure .env.production separately.
# Cloud preview and production builds obtain values from EAS configuration.
# GOOGLE_SERVICES_PLIST and GOOGLE_SERVICES_JSON are EAS secret file variables.
